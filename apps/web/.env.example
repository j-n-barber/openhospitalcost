# apps/web environment — copy to .env.local (gitignored) and fill in.

# Neon Postgres (mirrors the repo-root .env DATABASE_URL).
DATABASE_URL=

# Resend — powers the /contact and /corrections forms.
# Submissions are always stored in the DB; these only control the email notification.
RESEND_API_KEY=re_xxxxxxxx
# Must be on a domain verified in Resend (sending needs DNS records, not a mailbox).
RESEND_FROM=OpenHospitalCost <contact@openhospitalcost.com>
# Where form notifications are delivered (your real inbox).
FORM_NOTIFY_TO=contact@jnbarber.com

# --- Revenue / analytics ---
# Analytics: Vercel Analytics (no key needed — enable it in the Vercel project
# dashboard; the <Analytics/> component is already wired into the layout).
# Google AdSense publisher id (ca-pub-XXXXXXXXXXXXXXXX). Set to load AdSense.
# Ads only serve after AdSense approves the live site; place units with <AdSlot/>.
NEXT_PUBLIC_ADSENSE_CLIENT=
