# Copy this file to .env and fill in real values.
# .env is gitignored. Loaded manually via readFileSync (no dotenv package).

# Neon Postgres — production branch
DATABASE_URL=postgres://USER:PASSWORD@HOST/openhospitalcost?sslmode=require

# Neon Postgres — dev/experimentation branch
DATABASE_URL_DEV=postgres://USER:PASSWORD@HOST/openhospitalcost?sslmode=require&options=branch%3Ddev

# Cloudflare R2 — provisioned in Phase B
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=openhospitalcost-mrfs
