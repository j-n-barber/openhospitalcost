# The Vercel build only uses apps/web (Root Directory = apps/web, self-contained
# with its own package.json/lockfile). Everything else is data-pipeline tooling,
# large MRF samples, and build caches that must not be uploaded.

# Dependencies & build artifacts
node_modules/
**/node_modules/
.next/
**/.next/
apps/web/out/

# Data pipeline (1.7GB of MRF samples, duckdb binary, snapshots) — not used by the
# web app. LEADING SLASH = repo-root only: an unanchored `data/` also matched the
# web app's `apps/web/app/data/` route and 404'd /data sitewide (footer-linked).
/pipeline/
/data/
/db/
/scripts/
/test/
/.bin/

# Design / brand source assets (not needed at build)
/design/
/brand/
/Logo.ai

# Local + tooling
# (/.git/ must NOT be listed: vercel.json's ignoreCommand runs `git diff` in the
# build container, and the .vercelignore removal step runs before it. The CLI
# never uploads .git anyway, so excluding it only breaks the git-based skip.)
/.github/
/.claude/
/.agents/
*.log
.DS_Store
